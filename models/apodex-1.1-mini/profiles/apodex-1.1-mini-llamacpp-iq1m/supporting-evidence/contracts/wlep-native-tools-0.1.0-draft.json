  },
  "tool_catalog": [
    {
      "type": "function",
      "function": {
        "name": "get_part_stock",
        "description": "Get current stock count for a part.",
        "parameters": {
          "type": "object",
          "properties": {
            "part_id": {
              "type": "string"
            }
          },
          "required": [
            "part_id"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_price",
        "description": "Get price. Default currency USD.",
        "parameters": {
          "type": "object",
          "properties": {
            "part_id": {
              "type": "string"
            },
            "currency": {
              "type": "string",
              "enum": [
                "USD",
                "EUR"
              ]
            }
          },
          "required": [
            "part_id"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "list_parts",
        "description": "List parts by category.",
        "parameters": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "gpu",
                "cooling",
                "network"
              ]
            },
            "in_stock_only": {
              "type": "boolean"
            }
          },
          "required": [
            "category"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "order_part",
        "description": "Order parts. Quantity must be an integer between 1 and 10.",
        "parameters": {
          "type": "object",
          "properties": {
            "part_id": {
              "type": "string"
            },
            "qty": {
              "type": "integer"
            }
          },
          "required": [
            "part_id",
            "qty"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "schedule_maintenance",
        "description": "Schedule maintenance window.",
        "parameters": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "routine",
                "emergency"
              ]
            }
          },
          "required": [
            "date",
            "priority"
          ]
        }
      }
    },
    {
