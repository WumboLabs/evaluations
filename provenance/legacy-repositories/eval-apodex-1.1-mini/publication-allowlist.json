{
  "version": "1.0",
  "policy": "ALLOWLIST_FIRST",
  "default_public_eligibility": "DO_NOT_PUBLISH",
  "root": "evals/apodex-1.1-mini",
  "future_repo": "WumboLabs/eval-apodex-1.1-mini",
  "default": "DO_NOT_PUBLISH",
  "allowed": [
    "README.md",
    "MODEL.md",
    "model-manifest.json",
    "PUBLICATION-POLICY.md",
    "publication-policy.json",
    "PUBLICATION-MANIFEST.json",
    "publication-allowlist.json",
    ".gitignore",
    "WLEP-CONFORMANCE.md",
    "contracts/**",
    "localmaxxing/**",
    "protocol-findings.md",
    "report.md",
    "scorers/**",
    "scripts/**",
    "summaries/**"
  ],
  "excluded": [
    "sources/**",
    "runtime/**",
    "logs/**",
    "telemetry/**",
    "models",
    "models/**",
    "omp/**",
    "__pycache__/**",
    "*.pyc",
    ".env",
    ".env.*",
    "credentials*",
    "secrets*",
    "auth*",
    "calibration/**",
    "protocol-snapshot/**",
    "publication/**",
    "results/**"
  ],
  "reason": "Bounded Phase-3 early-stop evidence and reproducibility materials."
}
